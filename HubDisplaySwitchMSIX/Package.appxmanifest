<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <!-- The Store identity reserved in Partner Center (Store ID 9P1S2QJFXZFW), also store_identity and
       store_publisher in windows-build.json. Signed dev builds are stamped with dev_identity and the
       signing certificate's publisher by the kit's build-msix.ps1; Store uploads (-NoSign) keep these values. -->
  <Identity
    Name="DynamicSolutionsCA.HubDisplaySwitch"
    Publisher="CN=B55B96A5-F10C-49D3-8D0B-7260EDBE7625"
    Version="VERSION_PLACEHOLDER"
    ProcessorArchitecture="ARCH_PLACEHOLDER" />

  <Properties>
    <DisplayName>DisplaySwitchr</DisplayName>
    <PublisherDisplayName>Dynamic Solutions (CA)</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- Windows 10 22H2 from build 19045.5011, and Windows 11: the family floor decided in the standards (D-018). -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19045.5011" MaxVersionTested="10.0.26100.0" />
    <PackageDependency Name="Microsoft.WindowsAppRuntime.2" MinVersion="2.7.0.0" Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <!-- The languages match the app's catalogs (npm run check:l10n). ms-resource:Resources/<Key> strings
       come from those catalogs: manifest_strings in windows-build.json, written by the kit's build-msix.ps1. -->
  <Resources>
    <Resource Language="en-US" />
    <Resource Language="en-CA" />
    <Resource Language="es-ES" />
    <Resource Language="fr-FR" />
    <Resource Language="fr-CA" />
    <Resource Language="de-DE" />
    <Resource Language="zh-CN" />
    <Resource Language="pt-BR" />
    <Resource Language="ja-JP" />
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="HubDisplaySwitch.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="DisplaySwitchr"
        BackgroundColor="transparent"
        Square150x150Logo="Images\Square150x150Logo.png"
        Square44x44Logo="Images\Square44x44Logo.png"
        Description="ms-resource:Resources/AppDescription">
        <uap:SplashScreen Image="Images\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- desktop: (not uap:) namespace - makeappx rejects uap: startup tasks for full-trust apps. -->
        <desktop:Extension Category="windows.startupTask">
          <desktop:StartupTask TaskId="HubDisplaySwitchStartup" Enabled="true" DisplayName="DisplaySwitchr" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
