<Page
    x:Class="HubDisplaySwitch.Pages.SetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="36,12,36,36" Spacing="8" MaxWidth="960" HorizontalAlignment="Stretch">

            <!-- Header: icon, name, delete -->
            <Grid ColumnSpacing="14" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="GlyphButton" Width="56" Height="56" Padding="0" CornerRadius="10"
                        ToolTipService.ToolTip="Change icon">
                    <FontIcon x:Name="GlyphIcon" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <Button.Flyout>
                        <Flyout x:Name="GlyphFlyout">
                            <GridView x:Name="GlyphGrid" SelectionMode="None" IsItemClickEnabled="True" ItemClick="GlyphGrid_ItemClick" MaxWidth="260">
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <FontIcon Glyph="{x:Bind}" FontSize="20" Width="40" Height="40" />
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <TextBox x:Name="NameBox" Grid.Column="1" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"
                         PlaceholderText="Setup name" TextChanged="NameBox_TextChanged" />
                <Button Grid.Column="2" VerticalAlignment="Center" Click="Delete_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        <TextBlock Text="Delete" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Trigger -->
            <TextBlock Text="Use this setup when" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,8,0,2" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="4">
                    <RadioButton x:Name="DefaultRadio" GroupName="Trigger" Checked="Trigger_Checked">
                        <StackPanel>
                            <TextBlock Text="No hub setup is active (default)" />
                            <TextBlock Text="For devices plugged straight into the PC, like at your desk. Only one setup can be the default."
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="HubRadio" GroupName="Trigger" Checked="Trigger_Checked">
                        <StackPanel>
                            <TextBlock Text="One of these USB hubs is connected" />
                            <TextBlock Text="If several hubs are connected, the one connected most recently wins."
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </RadioButton>
                    <StackPanel x:Name="HubSection" Margin="28,8,0,0" Spacing="6">
                        <StackPanel x:Name="HubsPanel" Spacing="6" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <DropDownButton x:Name="AddHubButton">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                    <TextBlock Text="Add hub" />
                                </StackPanel>
                                <DropDownButton.Flyout>
                                    <MenuFlyout x:Name="AddHubMenu" Placement="BottomEdgeAlignedLeft" Opening="AddHubMenu_Opening" />
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <Button Click="DetectHub_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE721;" FontSize="12" />
                                    <TextBlock Text="Detect by unplugging…" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Displays -->
            <TextBlock Text="Displays" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,16,0,2" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Turn on the selected displays and turn everything else off. The main display gets the taskbar and new windows."
                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <StackPanel x:Name="DisplaysPanel" Spacing="6" Margin="0,6,0,0" />
                    <ToggleSwitch x:Name="MirrorSwitch" Header="Mirror (same picture on all selected displays)" Toggled="MirrorSwitch_Toggled" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Audio -->
            <TextBlock Text="Audio" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,16,0,2" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Each device you pick becomes the Windows default, for calls too. A TV's HDMI audio appears a few seconds after its display turns on; the switch waits for it."
                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <FontIcon Glyph="&#xE767;" FontSize="18" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                        <ComboBox x:Name="OutputCombo" Grid.Column="1" Header="Playback (output)" MinWidth="420" HorizontalAlignment="Left"
                                  SelectionChanged="OutputCombo_SelectionChanged" />
                        <FontIcon Grid.Row="1" Glyph="&#xE720;" FontSize="18" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                        <ComboBox x:Name="InputCombo" Grid.Row="1" Grid.Column="1" Header="Recording (input)" MinWidth="420" HorizontalAlignment="Left"
                                  SelectionChanged="InputCombo_SelectionChanged" />
                    </Grid>
                </StackPanel>
            </Border>

            <Button Style="{StaticResource AccentButtonStyle}" Margin="0,16,0,0" Click="SwitchNow_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE768;" FontSize="13" />
                    <TextBlock Text="Switch to this setup now" />
                </StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</Page>
