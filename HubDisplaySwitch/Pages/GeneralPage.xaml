<Page
    x:Class="HubDisplaySwitch.Pages.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:WinUIAppKit.Localization">
    <ScrollViewer>
        <StackPanel Padding="36,12,36,36" Spacing="8" MaxWidth="960" HorizontalAlignment="Stretch">
            <TextBlock l10n:Localize.Text="Settings" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12" />

            <TextBlock l10n:Localize.Text="Behaviour" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,0,0,2" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="4">
                    <ToggleSwitch x:Name="StartupSwitch" l10n:Localize.Header="Start with Windows" Toggled="StartupSwitch_Toggled"
                                  l10n:Localize.OnContent="On" l10n:Localize.OffContent="Off" />
                    <TextBlock x:Name="StartupNote" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" Margin="0,-4,0,8" />
                    <ToggleSwitch x:Name="ApplyOnStartSwitch" l10n:Localize.Header="Switch to the right setup when the app starts (for example after you sign in)"
                                  l10n:Localize.OnContent="On" l10n:Localize.OffContent="Off"
                                  IsOn="{x:Bind Settings.ApplyOnStart, Mode=TwoWay}" Toggled="Persist" />
                    <ToggleSwitch x:Name="OsdSwitch" l10n:Localize.Header="Show a popup while switching"
                                  l10n:Localize.OnContent="On" l10n:Localize.OffContent="Off"
                                  IsOn="{x:Bind Settings.ShowOsd, Mode=TwoWay}" Toggled="Persist" />
                    <ToggleSwitch x:Name="AutoSwitch" l10n:Localize.Header="Switch automatically when hubs connect or disconnect" Toggled="AutoSwitch_Toggled"
                                  l10n:Localize.OnContent="On" l10n:Localize.OffContent="Off" />
                </StackPanel>
            </Border>

            <TextBlock l10n:Localize.Text="Appearance" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,16,0,2" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="16">
                    <ComboBox x:Name="LanguageCombo" l10n:Localize.Header="Interface language" MinWidth="260" SelectionChanged="LanguageCombo_SelectionChanged" />
                    <ComboBox x:Name="ThemeCombo" l10n:Localize.Header="App theme" MinWidth="260" SelectionChanged="ThemeCombo_SelectionChanged">
                        <ComboBoxItem l10n:Localize.Content="Use system setting" />
                        <ComboBoxItem l10n:Localize.Content="Light" />
                        <ComboBoxItem l10n:Localize.Content="Dark" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <TextBlock l10n:Localize.Text="Reset" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,16,0,2" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock l10n:Localize.Text="Replace every setup and setting with the defaults. Your current settings are kept in a backup file in the logs folder."
                               Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Click="ResetSettings_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE777;" FontSize="14" />
                            <TextBlock l10n:Localize.Text="Reset settings" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
