<Page
    x:Class="HubDisplaySwitch.Pages.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:WinUIAppKit.Localization"
    xmlns:kitc="using:WinUIAppKit.Controls">
    <ScrollViewer>
        <StackPanel Style="{StaticResource PageContentStyle}">
            <TextBlock l10n:Localize.Text="kit.settings.title" Style="{StaticResource PageTitleStyle}" />

            <!-- The kit's "settings were reset" notice goes here, after an unreadable settings file (CONF-2) -->
            <ContentPresenter x:Name="NoticeHost" />

            <TextBlock l10n:Localize.Text="Behaviour" Style="{StaticResource FirstSectionHeaderStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <kitc:StartupSetting x:Name="StartupRow" />
                    <ToggleSwitch x:Name="ApplyOnStartSwitch" l10n:Localize.Header="Switch to the right setup when the app starts (for example after you sign in)"
                                  l10n:Localize.OnContent="kit.settings.on" l10n:Localize.OffContent="kit.settings.off"
                                  IsOn="{x:Bind Settings.ApplyOnStart, Mode=TwoWay}" Toggled="Persist" />
                    <ToggleSwitch x:Name="OsdSwitch" l10n:Localize.Header="Show a popup while switching"
                                  l10n:Localize.OnContent="kit.settings.on" l10n:Localize.OffContent="kit.settings.off"
                                  IsOn="{x:Bind Settings.ShowOsd, Mode=TwoWay}" Toggled="Persist" />
                    <ToggleSwitch x:Name="AutoSwitch" l10n:Localize.Header="Switch automatically when hubs connect or disconnect" Toggled="AutoSwitch_Toggled"
                                  l10n:Localize.OnContent="kit.settings.on" l10n:Localize.OffContent="kit.settings.off" />
                </StackPanel>
            </Border>

            <TextBlock l10n:Localize.Text="Appearance" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <kitc:LanguageSetting x:Name="LanguageRow" />
                    <kitc:ThemeSetting x:Name="ThemeRow" />
                </StackPanel>
            </Border>

            <TextBlock l10n:Localize.Text="Reset" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <kitc:ResetSetting x:Name="ResetRow" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
