<Window
    x:Class="HubDisplaySwitch.Windows.OsdWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Hub Display Switch Popup">
    <Grid x:Name="WindowRoot" Padding="18,0,18,0" ColumnSpacing="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ProgressRing x:Name="Spinner" Width="26" Height="26" IsActive="False" VerticalAlignment="Center" />
        <FontIcon x:Name="StateIcon" FontSize="24" Visibility="Collapsed" VerticalAlignment="Center"
                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock x:Name="TitleText" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="15" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="SubText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</Window>
