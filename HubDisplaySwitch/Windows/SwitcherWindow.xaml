<Window
    x:Class="HubDisplaySwitch.Windows.SwitcherWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Hub Display Switch">
    <Grid x:Name="WindowRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Padding="18,14,14,6">
            <TextBlock Text="Display setups" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
            <ToggleSwitch x:Name="AutoSwitch" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="0"
                          OnContent="Auto-switch" OffContent="Paused" Toggled="AutoSwitch_Toggled"
                          ToolTipService.ToolTip="Switch automatically when hubs connect or disconnect" />
        </Grid>

        <!-- Setup tiles (built in code) -->
        <StackPanel x:Name="TilesPanel" Grid.Row="1" Padding="8,0,8,8" Spacing="2" />

        <!-- Footer -->
        <Grid Grid.Row="2" Padding="18,10,10,10"
              Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,110,0" TextTrimming="CharacterEllipsis" />
            <Button HorizontalAlignment="Right" Click="Settings_Click" ToolTipService.ToolTip="Settings">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                    <TextBlock Text="Settings" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
