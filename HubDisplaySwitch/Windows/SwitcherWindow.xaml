<Window
    x:Class="HubDisplaySwitch.Windows.SwitcherWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:WinUIAppKit.Localization"
    Title="Hub Display Switch">
    <Grid x:Name="WindowRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Padding="18,14,14,6" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock l10n:Localize.Text="Display setups" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <ToggleSwitch x:Name="AutoSwitch" Grid.Column="1" VerticalAlignment="Center" MinWidth="0"
                          l10n:Localize.OnContent="Auto-switch" l10n:Localize.OffContent="Paused" Toggled="AutoSwitch_Toggled"
                          l10n:Localize.ToolTip="Switch automatically when hubs connect or disconnect" />
        </Grid>

        <!-- Setup tiles (built in code) -->
        <StackPanel x:Name="TilesPanel" Grid.Row="1" Padding="8,0,8,8" Spacing="2" />

        <!-- Footer -->
        <Grid Grid.Row="2" Padding="18,10,10,10"
              Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            <Button x:Name="SettingsButton" Grid.Column="1" Click="Settings_Click">
                <StackPanel Style="{StaticResource IconLabelStyle}">
                    <FontIcon Glyph="&#xE713;" Style="{StaticResource ButtonGlyphStyle}" />
                    <TextBlock l10n:Localize.Text="kit.settings.title" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
