<Window
    x:Class="HubDisplaySwitch.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:WinUIAppKit.Localization"
    Title="Hub Display Switch">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" VerticalAlignment="Top" Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image x:Name="TitleBarIcon" Width="16" Height="16" Margin="16,0,8,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Hub Display Switch" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <NavigationView x:Name="RootNavigation" Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsPaneToggleButtonVisible="True"
                        OpenPaneLength="240"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        SelectionChanged="RootNavigation_SelectionChanged"
                        ItemInvoked="RootNavigation_ItemInvoked">
            <NavigationView.FooterMenuItems>
                <NavigationViewItem l10n:Localize.Content="Our other apps" Tag="PromoPage">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE719;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem l10n:Localize.Content="About" Tag="AboutPage">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
