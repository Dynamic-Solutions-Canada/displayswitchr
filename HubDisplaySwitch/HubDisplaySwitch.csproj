<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <!-- Runs on Windows 10 22H2 too (the manifest's floor); APIs newer than that need a runtime check,
         which the platform analyzer enforces. -->
    <SupportedOSPlatformVersion>10.0.19045.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>$(SupportedOSPlatformVersion)</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <RootNamespace>HubDisplaySwitch</RootNamespace>
    <AssemblyName>HubDisplaySwitch</AssemblyName>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Configurations>Debug;Release</Configurations>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\HubDisplaySwitch.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- NuGet packages (versions in Directory.Packages.props) -->
  <ItemGroup>
    <!-- System.Drawing for runtime tray-icon rendering -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />

    <!-- WinUI 3 (Windows App SDK): Fluent Design, Mica, NavigationView -->
    <PackageReference Include="Microsoft.WindowsAppSDK" />

    <!-- MVVM source generators (ObservableProperty, RelayCommand) -->
    <PackageReference Include="CommunityToolkit.Mvvm" />

    <!-- USB device enumeration + change events (WMI) -->
    <PackageReference Include="System.Management" />

    <!-- Structured logging; the shared NLog.config is linked by the kit's build targets -->
    <PackageReference Include="NLog" />
  </ItemGroup>

  <!-- Shared tray/flyout/settings/startup/theme/localization plumbing (submodule) -->
  <ItemGroup>
    <ProjectReference Include="..\external\winui-app-kit\WinUIAppKit\WinUIAppKit.csproj" />
  </ItemGroup>

  <!-- Content files to copy to output -->
  <ItemGroup>
    <None Remove="Resources\HubDisplaySwitch.ico" />
    <None Remove="Resources\HubDisplaySwitch.png" />
    <None Remove="THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Resources\HubDisplaySwitch.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\HubDisplaySwitch.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Generated by winui-app-kit's generate-notices.py (npm run generate:notices, HYG-3); ships in the package beside the app -->
    <Content Include="THIRD-PARTY-NOTICES.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- UI text catalogs (English-keyed JSON). Checked by winui-app-kit's check-localization.py (npm run check:l10n). -->
  <ItemGroup>
    <EmbeddedResource Include="Localization\Catalogs\*.json" LogicalName="HubDisplaySwitch.Localization.%(Filename).json" />
  </ItemGroup>

  <!-- winui-app-kit's shared XAML: styles, the About page and the Settings rows -->
  <Import Project="..\external\winui-app-kit\Xaml\WinUIAppKit.Xaml.projitems" Label="Shared" />

  <!-- Shared "Our other apps" cross-promo page (submodule). Bundled data is the offline
       fallback; the page refreshes its public manifest at runtime. -->
  <Import Project="..\external\promo\PromotedApps.projitems" Label="Shared" />
</Project>
